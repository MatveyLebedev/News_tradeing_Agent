<!-- ClickHouse's own system logs grow without bound and are not used by Langfuse.
     Drop the heavy ones and age out query_log, so the disk holds traces, not diagnostics. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <size>50M</size>
        <count>3</count>
    </logger>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
</clickhouse>
