# LangSmith Configuration
# Get your API key from https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxx
LANGCHAIN_PROJECT=news-trading-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=elemental-alloy-455119-p5-cdc71d0037a1.json
GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_PROJECT=elemental-alloy-455119-p5
LLM_LOCATION=us-central1

# Database Configuration
DB_HOST=YOUR_DB_HOST
DB_NAME=news
DB_USER=admin
DB_PASSWORD=YOUR_DB_PASSWORD
DB_PORT=5432

# Agent Configuration
CONFIDENCE_THRESHOLD=0.7
LOOKBACK_DAYS_DEFAULT=1
LOOKBACK_DAYS_TECHNICAL=30
LOOKBACK_DAYS_VOLATILITY=30
MAX_REFLECTION_ITERATIONS=2

# Risk Parameters
MAX_STOP_LOSS_PERCENT=5.0
MIN_TAKE_PROFIT_PERCENT=3.0
RISK_REWARD_RATIO=2.0
STOP_LOSS_METHOD=ATR
ATR_MULTIPLIER=2.0

# News Analysis Parameters
RECENT_NEWS_LOOKBACK_HOURS=24
PRICE_MOVEMENT_WINDOW_MINUTES=40
MIN_TIME_BEFORE_CLOSE_MINUTES=60
SIMILAR_NEWS_TOP_K=5

# Volatility Detection
VOLUME_SPIKE_MULTIPLIER=2.0
HIGH_VOLATILITY_THRESHOLD=1.5

# Embedding Model
EMBEDDING_MODEL=text-embedding-004
