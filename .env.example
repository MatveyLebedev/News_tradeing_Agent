# Trading Agent Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================
DB_HOST=<SERVER_IP>
DB_NAME=trade_agent
DB_USER=news
DB_PASSWORD=YOUR_DB_PASSWORD
# 5432 = server-internal (used by containers ON the host). From OUTSIDE the server
# the ISP blocks 5432 — use 5544 instead. Neo4j is the same: internal 7687, external 7688.
DB_PORT=5432

# ============================================================================
# Open Router Configuration (REQUIRED for LLM)
# ============================================================================
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ============================================================================
# Google Cloud / Vertex AI Configuration (for embeddings only)
# ============================================================================
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-credentials.json

# ============================================================================
# Langfuse tracing (OPTIONAL) — self-hosted, deploy/langfuse/README.md
# ============================================================================
# Keys come from deploy/langfuse/.env (LANGFUSE_INIT_PROJECT_*). Inside the server
# network the URL is http://langfuse-web:3000; locally http://localhost:<LANGFUSE_PORT>.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
# The long-term scheduler traces every run when the keys are set. Opt out with LT_TRACE=false.
# LT_TRACE=true

# ============================================================================
# LLM Models — ЕДИНАЯ ТОЧКА СМЕНЫ МОДЕЛЕЙ (меняй только здесь)
# Любой OpenRouter-slug, напр.: deepseek/deepseek-v4-pro, openai/gpt-oss-120b
# ============================================================================
# NOTE: no inline '# comments' on these lines — docker --env-file keeps them as
# part of the value (breaks the model name). Put comments on their own line.
# flash: основной агент (news_agent)
LLM_MODEL=google/gemini-3-flash-preview
# flash-lite: граф + forecast
GRAPH_LLM_MODEL=google/gemini-3.1-flash-lite-preview
# strong: longterm-агент, ТОЛЬКО три judgement-узла (synthesis, fundamentals verdict,
# deep-analysis reduce). Пусто = LLM_MODEL (сплит выключен). Включение — eval-gated
# изменение: пре-регистрация в docs/BACKTEST_LEDGER.md (эксперимент wf_30x_strong),
# бюджет +200%/прогон. Кандидат: anthropic/claude-sonnet-5 (+106% при текущих объёмах).
# STRONG_LLM_MODEL=
# эмбеддинги (семантический поиск)
EMBEDDING_MODEL=google/gemini-embedding-001
# должна поддерживаться embedding-моделью
EMBEDDING_DIMENSIONS=1536
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_TOKENS=64000

# ============================================================================
# Fundamentals Fetcher (OPTIONAL - for the long-term agent)
# ============================================================================
# Enable the weekly fundamentals fetch (EDGAR point-in-time statements + yfinance snapshots)
FETCH_FUNDAMENTALS=false
FUNDAMENTALS_FETCH_WEEKDAY=saturday   # weekday for the weekly run
FUNDAMENTALS_FETCH_TIME=03:00         # ET, off-market

# Daily OHLCV bars — a SEPARATE job, on by default and NOT gated by FETCH_FUNDAMENTALS:
# grading, /open's vs-SPY leg and the batch freshness preflight all read these daily.
# The period is deliberately wider than the cadence so a dropped or missed bar heals itself.
DAILY_BARS_FETCH_ENABLED=true
DAILY_BARS_FETCH_TIME=22:30           # ET; NOT 20:30 — Yahoo serves the day's bar as NaN just after 20:00
DAILY_BARS_RETRY_TIME=06:15           # ET, second pass before the 07:00 grader (empty = off)
DAILY_BARS_PERIOD=1mo                 # heal window

# Graph maintenance — bounds the news->graph fan-out (Neo4j Stories + pgvector).
# Without it, stale Stories never close, duplicates never merge, and
# graph_event_embeddings has no TTL (the main ongoing-disk drivers).
GRAPH_MAINTENANCE_ENABLED=true
GRAPH_CLEANUP_TIME=04:00              # ET, daily: close stale stories + purge old embeddings
GRAPH_MERGE_WEEKDAY=sunday            # weekly dedup merge
GRAPH_MERGE_TIME=04:30                # ET
EVENT_EMBEDDING_RETENTION_DAYS=365    # graph_event_embeddings TTL in days (0 = keep all)

# Startup DB maintenance — one-time disk-reclaim runbook at boot (idempotent:
# drops legacy JSONB embedding columns + GIN indexes, redundant price indexes,
# tunes autovacuum, reclaims heap). OFF by default (migration already complete);
# set true to run the cleanup once more.
DB_MAINTENANCE_ON_START=false
# VACUUM FULL holds a brief lock on `news` + needs ~1x free disk. Runs automatically
# the first time legacy columns are dropped; set true to force it on a later boot.
DB_VACUUM_FULL_ON_START=false
EDGAR_HISTORY_YEARS=7                 # how many years of EDGAR statements to keep
# SEC fair-access policy REQUIRES a descriptive User-Agent with contact info:
SEC_EDGAR_USER_AGENT=YourName your@email.com

# ============================================================================
# Long-Term Agent — Ops / Phase 6 (weekly scheduler, alerts, stats bot)
# ============================================================================
# Weekly full-pipeline batch cadence (ET). Run AFTER the weekly fundamentals fetch.
LT_BATCH_WEEKDAY=sunday
LT_BATCH_TIME=06:00
LT_GRADE_TIME=07:00                 # daily grading of matured cohorts
LT_RUN_ON_START=false              # run one batch immediately when the scheduler starts
# LT_UNIVERSE=NVDA,AAPL,MSFT,...   # override universe (default: TOP_50_TICKERS)
LT_ALERT_ON_ERROR=true

# Telegram — push alerts (batch job) + the read-only stats bot.
# Reuses the main bot token/chat if the LT_* ones are unset.
# TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
# TELEGRAM_CHAT_ID=-1001234567890         # chat/channel to push alerts to
# LT_TELEGRAM_BOT_TOKEN=                   # (optional) a SEPARATE bot just for the long-term agent
# LT_TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=               # comma-separated user ids allowed to query the stats bot

# Long-term agent windows / thresholds (OPTIONAL - has defaults; see longterm_agent/config.py)
# LT_LOOKBACK_DAYS=60
# LT_CONF_THRESHOLD=0.55
# LT_MAX_REFLECTION=1

# Backtest reproducibility (Backtest Plan B0). Content-addressed LLM cache: first run records,
# later runs of the same cohort replay → deterministic + ~zero token cost. Safe anywhere (a hit
# needs a byte-identical prompt). Recommended ON for backtests, with LT_MAX_REFLECTION=0.
# LT_LLM_CACHE=false
# Require a detected news-background SHIFT for a tradeable signal (default true). Keeps the
# trade decision reproducible — no-shift signals are capped below threshold (not traded).
# Set false to also allow strong no-shift setups to trade.
# LT_REQUIRE_SHIFT=true

# Deep analysis (Phase 7A): bounded ReAct tool-calling that enriches the thesis of SHIFTED
# tickers (chooses what to investigate — sector breadth, causal chain, novelty, analogs).
# Advisory only: it never changes the deterministic shift label. ON live for richer theses;
# turn OFF for backtests so labels stay reproducible (pair with LT_LLM_CACHE=true).
# LT_DEEP_ANALYSIS=true
# LT_MAX_TOOL_ITERS=7              # hard cap on tool-call iterations (forced finalize on last)
# LT_TOOL_RESULT_MAX_CHARS=3000   # truncate each tool result before appending (keeps context lean)

# ============================================================================
# Trading Parameters (OPTIONAL - has defaults)
# ============================================================================
CONFIDENCE_THRESHOLD=0.7
MAX_REFLECTION_ITERATIONS=1
MAX_TOOL_CALL_ITERATIONS=3
