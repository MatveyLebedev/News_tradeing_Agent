# Trading Agent Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================
DB_HOST=YOUR_SERVER_IP
DB_NAME=trade_agent
DB_USER=news
DB_PASSWORD=YOUR_DB_PASSWORD
DB_PORT=5432

# ============================================================================
# Open Router Configuration (REQUIRED for LLM)
# ============================================================================
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ============================================================================
# Google Cloud / Vertex AI Configuration (for embeddings only)
# ============================================================================
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-credentials.json

# ============================================================================
# LangSmith Configuration (OPTIONAL - for tracing)
# ============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=news-trading-agent

# ============================================================================
# LLM Models — ЕДИНАЯ ТОЧКА СМЕНЫ МОДЕЛЕЙ (меняй только здесь)
# Любой OpenRouter-slug, напр.: deepseek/deepseek-v4-pro, openai/gpt-oss-120b
# ============================================================================
LLM_MODEL=google/gemini-3-flash-preview            # flash: основной агент (news_agent)
GRAPH_LLM_MODEL=google/gemini-3.1-flash-lite-preview  # flash-lite: граф + forecast
EMBEDDING_MODEL=google/gemini-embedding-001        # эмбеддинги (семантический поиск)
EMBEDDING_DIMENSIONS=1536                          # должна поддерживаться embedding-моделью
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_TOKENS=64000

# ============================================================================
# Fundamentals Fetcher (OPTIONAL - for the long-term agent)
# ============================================================================
# Enable the weekly fundamentals fetch (EDGAR point-in-time statements + yfinance snapshots)
FETCH_FUNDAMENTALS=false
FUNDAMENTALS_FETCH_WEEKDAY=saturday   # weekday for the weekly run
FUNDAMENTALS_FETCH_TIME=03:00         # ET, off-market
EDGAR_HISTORY_YEARS=7                 # how many years of EDGAR statements to keep
# SEC fair-access policy REQUIRES a descriptive User-Agent with contact info:
SEC_EDGAR_USER_AGENT=YourName your@email.com

# ============================================================================
# Long-Term Agent — Ops / Phase 6 (weekly scheduler, alerts, stats bot)
# ============================================================================
# Weekly full-pipeline batch cadence (ET). Run AFTER the weekly fundamentals fetch.
LT_BATCH_WEEKDAY=sunday
LT_BATCH_TIME=06:00
LT_GRADE_TIME=07:00                 # daily grading of matured cohorts
LT_RUN_ON_START=false              # run one batch immediately when the scheduler starts
# LT_UNIVERSE=NVDA,AAPL,MSFT,...   # override universe (default: TOP_50_TICKERS)
LT_ALERT_ON_ERROR=true

# Telegram — push alerts (batch job) + the read-only stats bot.
# Reuses the main bot token/chat if the LT_* ones are unset.
# TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
# TELEGRAM_CHAT_ID=-1001234567890         # chat/channel to push alerts to
# LT_TELEGRAM_BOT_TOKEN=                   # (optional) a SEPARATE bot just for the long-term agent
# LT_TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=               # comma-separated user ids allowed to query the stats bot

# Long-term agent windows / thresholds (OPTIONAL - has defaults; see longterm_agent/config.py)
# LT_LOOKBACK_DAYS=60
# LT_CONF_THRESHOLD=0.55
# LT_MAX_REFLECTION=1

# ============================================================================
# Trading Parameters (OPTIONAL - has defaults)
# ============================================================================
CONFIDENCE_THRESHOLD=0.7
MAX_REFLECTION_ITERATIONS=1
MAX_TOOL_CALL_ITERATIONS=3
